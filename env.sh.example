# ローカル実行用の環境変数テンプレート。
#   cp env.sh.example env.sh   して各自のパスに書き換えてください（env.sh は .gitignore 済み）。

# モデル重み・データセットのキャッシュ置き場（十分な空き容量のあるパスに）
export PBO_CACHE="$HOME/.cache/rapid-plate"

export SKRUB_DATA_DIRECTORY="$PBO_CACHE/skrub"
export HF_HOME="$PBO_CACHE/hf"
export TABPFN_MODEL_CACHE_DIR="$PBO_CACHE/tabpfn"
export XDG_CACHE_HOME="$PBO_CACHE"
export MPLCONFIGDIR="$PBO_CACHE/mpl"

# ワーカー並列と BLAS スレッドの二重並列を避ける
export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
